{
  "editor": "cursor",
  "tree": {
    "defaultBase": "main",
    "installCommand": "npm install",
    "devCommand": "PORT={{port}} npm run dev -- --port {{port}}",
    "copyEnv": true,
    "portStart": 3001,
    "portEnd": 3099
  },
  "pr": {
    "defaultBase": "main",
    "draft": false
  },
  "sync": {
    "defaultBase": "main",
    "strategy": "rebase",
    "reinstall": true
  }
}
